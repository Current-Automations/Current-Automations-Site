# Environment variables this app needs. Real values live in the Vercel project
# settings (Production and Preview), never in the repo. Copy to .env.local for
# local development.

# Stripe Checkout, used by app/api/checkout
STRIPE_SECRET_KEY=

# Twilio, used by app/api/voice (the TwiML webhook for browser dialing).
# TWILIO_AUTH_TOKEN must be the account auth token, not an API key secret:
# Twilio signs webhook requests with the auth token specifically.
TWILIO_AUTH_TOKEN=
# The AC... account SID. Left blank on purpose: GitHub secret scanning flags it as
# a Twilio Account String Identifier and blocks the push. Copy it from the Twilio
# console or the Vercel project settings.
TWILIO_ACCOUNT_SID=

# The TwiML Application whose Voice URL points at /api/voice.
TWILIO_TWIML_APP_SID=

# Default outbound caller ID for browser-placed calls, in E.164. This is the sales
# line, kept separate from the business line so cold-call volume cannot attract
# carrier spam flags on the published number. Left blank because this repo is
# public and there is no reason to hand a scraper the line roles. The real values
# and the reasoning behind the split are in ops/twilio/.env.example, which is not
# in any repo.
TWILIO_CALLER_ID=

# Every other line the dialer is allowed to place calls from, comma separated
# E.164 numbers. The browser sends its chosen line as the FromLine parameter, and
# /api/voice honours it only if it appears here, so caller ID cannot be set by
# whoever reaches the endpoint. Leave empty to pin every call to TWILIO_CALLER_ID.
# Must exclude the demo line, which is inbound only.
TWILIO_CALLER_IDS=

# Resend, used by app/api/contact for the site contact form. Create the key at
# resend.com and verify currentautomations.ca as a sending domain first, otherwise
# the send is rejected. Without this the form still renders but returns a 503 that
# tells the visitor to email info@ directly, so it never silently swallows a message.
RESEND_API_KEY=

# Demo-line SMS bot, used by app/api/sms-demo (the 365-299-3366 text door).
# Twilio's messaging webhook for that number points at /api/sms-demo. Needs the
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above as well.
SMS_DEMO_LINE=
# The personal cell every thread is forwarded to. Texts from this number to the
# demo line are commands (CODE message / RESUME CODE / DONE CODE / LIST), never
# answered by the bot.
SMS_FORWARD_TO=
# Anthropic API key. The bot runs claude-opus-5-5.
ANTHROPIC_API_KEY=
# Fine-grained GitHub token, read-only Contents on JarrettGoodwin/life-os. The bot
# reads Calendar/Weekly Schedule/YYYY-Www*.ics to offer real visit slots. Unset
# means no slots are ever offered and the bot says Jarrett will text times.
GITHUB_TOKEN_LIFEOS=
# Make custom webhook for the "Demo SMS Bot Events" scenario (calendar hold +
# Master Event Log row). Unset means events are logged to the function log only.
MAKE_EVENTS_WEBHOOK_URL=
# Stripe Payment Link for the $99 first-device setup (HST via Stripe Tax). Sent by
# the DONE command. Unset means the DONE text says the link is coming.
STRIPE_LINK_T1=
# Google Business Profile "write a review" link, sent the evening after a job.
GOOGLE_REVIEW_LINK=
# Offered beside the payment link as the e-transfer address.
BILLING_EMAIL=
# Vercel sets this on the daily cron call to /api/sms-demo/sweep; set the same
# value in the project env so the route can check it.
CRON_SECRET=
