# Environment variables this app needs. Real values live in the Vercel project
# settings (Production and Preview), never in the repo. Copy to .env.local for
# local development.

# Stripe Checkout, used by app/api/checkout
STRIPE_SECRET_KEY=

# Twilio, used by app/api/voice (the TwiML webhook for browser dialing).
# TWILIO_AUTH_TOKEN must be the account auth token, not an API key secret:
# Twilio signs webhook requests with the auth token specifically.
TWILIO_AUTH_TOKEN=
# The AC... account SID. Left blank on purpose: GitHub secret scanning flags it as
# a Twilio Account String Identifier and blocks the push. Copy it from the Twilio
# console or the Vercel project settings.
TWILIO_ACCOUNT_SID=

# The TwiML Application whose Voice URL points at /api/voice.
TWILIO_TWIML_APP_SID=

# Default outbound caller ID for browser-placed calls, in E.164. This is the sales
# line, kept separate from the business line so cold-call volume cannot attract
# carrier spam flags on the published number. Left blank because this repo is
# public and there is no reason to hand a scraper the line roles. The real values
# and the reasoning behind the split are in ops/twilio/.env.example, which is not
# in any repo.
TWILIO_CALLER_ID=

# Every other line the dialer is allowed to place calls from, comma separated
# E.164 numbers. The browser sends its chosen line as the FromLine parameter, and
# /api/voice honours it only if it appears here, so caller ID cannot be set by
# whoever reaches the endpoint. Leave empty to pin every call to TWILIO_CALLER_ID.
# Must exclude the demo line, which is inbound only.
TWILIO_CALLER_IDS=
